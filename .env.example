DASHSCOPE_API_KEY=replace_with_a_new_key
# Optional: override when the API Key creation dialog provides a dedicated API Host.
# DASHSCOPE_API_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_RESPONSES_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_CHAT_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_WS_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DEEPSEEK_API_KEY=replace_with_a_new_key
TEAMOROUTER_API_KEY=replace_with_a_new_key

# Anti-Bagu local runtime
ANTIBAGU_SERVER_HOST=127.0.0.1
ANTIBAGU_SERVER_PORT=8765
ANTIBAGU_MODEL_BASE_URL=https://api.deepseek.com
ANTIBAGU_MODEL_NAME=deepseek-v4-flash
ANTIBAGU_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ANTIBAGU_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
ANTIBAGU_FOCUS_PROMPT_TOKENS=8000
ANTIBAGU_FOCUS_DIALOGUE_TOKENS=6000
ANTIBAGU_FOCUS_HISTORY_TOKENS=1600
ANTIBAGU_FOCUS_CHARACTERS_PER_TOKEN=1.7
ANTIBAGU_FOCUS_DEBOUNCE_MS=300
ANTIBAGU_FOCUS_MAX_COALESCE_MS=1200
ANTIBAGU_FOCUS_TIMEOUT_SECONDS=5

# One JSONL file per local calendar day: .runtime/logs/YYYY-MM-DD.jsonl
ANTIBAGU_LOG_DIR=.runtime/logs
# Transcript/question/answer bodies are redacted by default. Enable only for local debugging.
ANTIBAGU_LOG_INCLUDE_TEXT=false
ANTIBAGU_LOG_RING_SIZE=1000
ANTIBAGU_LOG_QUEUE_SIZE=4096

# Cloud control plane. Production uses PostgreSQL; local development defaults to SQLite.
# ANTIBAGU_DATABASE_URL=postgresql+asyncpg://anti_bagu:password@127.0.0.1:5432/anti_bagu
ANTIBAGU_STORAGE_DIR=.runtime/storage
ANTIBAGU_PUBLIC_BASE_URL=http://127.0.0.1:5174
ANTIBAGU_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
ANTIBAGU_WEB_SESSION_DAYS=7
ANTIBAGU_AGENT_TOKEN_DAYS=30
ANTIBAGU_AUTO_CREATE_SCHEMA=true
# Required on first production boot. Keep these values only in /etc/anti-bagu/anti-bagu.env.
# ANTIBAGU_ADMIN_USERNAME=admin
# ANTIBAGU_ADMIN_PASSWORD=replace_with_a_random_password
